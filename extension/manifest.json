{
  "manifest_version": 3,
  "name": "三平台视频快捷捕获",
  "version": "0.6.0",
  "description": "捕获当前 YouTube、Bilibili 或 Douyin 作品，并交给本地调度器下载。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "https://youtu.be/*",
    "https://*.bilibili.com/*",
    "https://bilibili.com/*",
    "https://*.douyin.com/*",
    "https://douyin.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "查看下载任务",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "download-current-video": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "下载当前 YouTube、Bilibili 或 Douyin 作品"
    }
  },
  "options_page": "options.html"
}
